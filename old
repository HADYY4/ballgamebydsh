function noteAsset(){
  const v=state.marbles+state.coins*CFG.marblePerBuy, s=state.stats;
  if(typeof s.peakAsset!=='number') s.peakAsset=0;
  if(typeof s.bestEver!=='number') s.bestEver=0;
  if(v>s.peakAsset) s.peakAsset=v;
  if(v>s.bestEver) s.bestEver=v;
}
function isBroke(){ return state.marbles<1 && state.coins<CFG.coinPerBuy; }
/* 终身统计：累计获得弹珠 / 弹珠峰值（用于新成就） */
function noteMarbles(){ profile.life.peakMarbles=Math.max(profile.life.peakMarbles||0, state.marbles); }
function gotMarbles(n){ profile.life.marblesGot=(profile.life.marblesGot||0)+Math.max(0,n); noteMarbles(); }
function buyCoin(){
  if(state.phase!=='ready'){ toast('下注开始后不能投币，请等本回合结束','bad'); return; }
  if(state.coins<CFG.coinPerBuy){ toast('钱币不足','bad'); SFX.miss(); return; }
  state.coins-=CFG.coinPerBuy; state.marbles+=CFG.marblePerBuy;
  state.stats.coinsSpent+=CFG.coinPerBuy; state.stats.buys++;
  profile.life.coinsSpent+=CFG.coinPerBuy; profile.life.buys++;
  gotMarbles(CFG.marblePerBuy);
  SFX.coin();
  const got=[], cards=[];
  for(let i=0;i<CFG.promoDraws;i++){ const g=grantPromo(); got.push(g.text); cards.push(g); }
  pushLog('buy','投币 '+CFG.coinPerBuy+' 币 → +'+CFG.marblePerBuy+' 弹珠 · 促销：'+got.join(' + '),'-'+CFG.coinPerBuy+'币');
  say('投币成功！促销 BUFF：'+got.join('、')+'。');
  showBuffCards(cards);
  checkAcv(); renderHUD(); refreshPanel(); save();
}
function grantPromo(){
  const k=pick(PROMO_KEYS), d=PROMO_DEF[k];
  if(!state.promo[k]) state.promo[k]={lv:0,rounds:0};
  const b=state.promo[k], add=randInt(d.dmin,d.dmax), was=b.rounds>0;
  b.lv=1; b.rounds=Math.min(PROMO_DUR_CAP,b.rounds+add);
  state.stats.promoGained++; SFX.buff();
  return { icon:d.icon, name:d.name, pity:false,
    effect:ATTR_NAME[d.attr]+' +'+d.val+' · 持续 '+b.rounds+' 回合',
    delta:(was?'+'+add+' 回合（续时）':'+'+add+' 回合'),
    text:d.name+(was?'（续时 → 共 '+b.rounds+' 回合）':'（+'+add+' 回合）') };
}
function addMarbles(n){
  if(state.phase!=='ready'&&state.phase!=='betting') return false;
  n=Math.max(1,Math.floor(n||1)); if(state.marbles<n) n=state.marbles;
  if(n<1){ toast('弹珠不足，先投币','bad'); return false; }
  state.marbles-=n; state.roundBet+=n;
  state.stats.marblesIn+=n; profile.life.marblesIn+=n;
  profile.life.bestBet=Math.max(profile.life.bestBet||0, state.roundBet);
  if(state.phase==='ready'){ state.phase='betting'; startRoll(); }
  SFX.click(); checkAcv(); renderHUD(); save(); return true;
}
function startRoll(){
  stopRoll();
