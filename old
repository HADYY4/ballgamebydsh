   ========================================================================= */
let geom={};
function layoutMech(){
  const W=boardEl.clientWidth,H=boardEl.clientHeight;
  if(!W||!H) return;
  const n=CFG.holeCount;
  const padX=Math.max(38,W*0.055);
  const usable=Math.max(1,W-padX*2);
  const baseY=H-Math.max(84,Math.min(110,H*0.22));
  const amp=Math.min(24,H*0.055);
  const trayTop=baseY+36, trayBottom=H-6;
  const chuteW=26, chuteX=W-44, chuteTop=18, chuteBottom=trayTop+8;
  geom={W,H,padX,usable,baseY,amp,trayTop,trayBottom,chuteW,chuteX,chuteTop,chuteBottom,n};

  for(let i=0;i<n;i++){
    const t=n===1?0.5:i/(n-1);
    holeEls[i].style.left=(padX+usable*t)+'px';
    holeEls[i].style.top=(baseY+amp*Math.sin(Math.PI*t))+'px';
  }
  const dv=$('#dividers'); dv.innerHTML='';
  for(let i=0;i<n-1;i++){
    const t1=i/(n-1), t2=(i+1)/(n-1);
    const x1=padX+usable*t1, x2=padX+usable*t2;
    const y=Math.max(baseY+amp*Math.sin(Math.PI*t1), baseY+amp*Math.sin(Math.PI*t2));
    const d=document.createElement('div'); d.className='divider';
    d.style.left=((x1+x2)/2)+'px'; d.style.top=(y-14)+'px'; d.style.height=Math.max(10,trayTop-y+16)+'px';
    dv.appendChild(d);
  }
  const tray=$('#tray'); tray.style.top=trayTop+'px'; tray.style.height=(trayBottom-trayTop)+'px';
  const ch=$('#chute'); ch.style.left=(chuteX-chuteW/2)+'px'; ch.style.top=chuteTop+'px';
  ch.style.width=chuteW+'px'; ch.style.height=(chuteBottom-chuteTop)+'px';
  const gt=$('#gate'); gt.style.left=(chuteX-chuteW/2-12)+'px'; gt.style.top=(chuteBottom-30)+'px';
  gt.style.width='26px'; gt.style.height='5px';
  const st=$('#striker'); st.style.left=(chuteX-chuteW/2+3)+'px'; st.style.top=(chuteBottom-10)+'px';
