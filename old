  $('#tgFast').onchange=e=>{ state.fast=e.target.checked; renderHUD(); save(); };
  $('#tgSound').onchange=e=>{ state.sound=e.target.checked; renderHUD(); save(); if(state.sound) SFX.click(); };
  $$('.tab').forEach(t=>t.onclick=()=>{
    $$('.tab').forEach(x=>x.classList.remove('sel')); t.classList.add('sel');
    curTab=t.dataset.tab; renderPanel();
  });
  window.addEventListener('resize',()=>{ layoutMech(); if(curTab==='stats') drawCurve(); });
  window.addEventListener('keydown',e=>{
    if(e.code!=='Space') return; e.preventDefault();
    if(state.phase==='betting') confirmBet();
    else if(state.phase==='aim'){ if(state.target===null){ state.target=bestTarget(); renderHoles(); } fire(); }
    else if(state.phase==='ready') addMarbles(1);
  });
  say('欢迎！先投币（每次抽 '+CFG.promoDraws+' 个促销 BUFF），再下注开奖。');
  setHint('先「投币」补充弹珠，再下注：<b>＋投入 1 颗</b> 或批量投入，投完按 <b>确认</b> 开奖');
  save();
}
init();
</script>
</body>
</html>
