  setHint('已开奖：<b>'+state.rewardHoles.length+'</b> 个奖励孔 · 命中奖励 <b>'+state.rewardValue+'</b> 颗 × 倍率 <b>'+state.roundBet+
    '</b> —— 点一个孔瞄准'+(state.actSkills.alchemy>=1&&!state.alchemyUsed?'，可用「点石成金」改造该孔':'')+'，然后按「发射」');
  renderHoles(); renderCenter(); renderHUD(); save();
