function weightedIndex(w){ let t=0; for(let i=0;i<w.length;i++) t+=Math.max(0,w[i]);
  if(t<=0) return 0; let r=Math.random()*t;
  for(let i=0;i<w.length;i++){ r-=Math.max(0,w[i]); if(r<0) return i; } return w.length-1; }
function weightedPick(arr){ const w=arr.map(x=>x.w); return arr[weightedIndex(w)]; }
function nonzeroRange(w){ let lo=-1,hi=-1; for(let i=0;i<w.length;i++) if(w[i]>0){ if(lo<0)lo=i; hi=i; } return lo<0?[0,w.length-1]:[lo,hi]; }

