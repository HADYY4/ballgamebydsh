      {duration:640,easing:'ease-out',fill:'forwards',delay:idx*90});
    setTimeout(()=>ring.remove(),1250);
  });
  await wait(340);
  const txt=document.createElement('div'); txt.className='alch-text';
  txt.style.left=pos.x+'px'; txt.style.top=(pos.y-36)+'px';
