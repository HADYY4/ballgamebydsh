/* 点石成金 */
function applyAlchemy(i,lv,silent){
  const isR=state.rewardHoles.indexOf(i)>=0, isS=state.specialHoles.indexOf(i)>=0;
  if(isS) return false;
  if(isR){
    if(Math.random()<ALCH_UP[lv]){ state.specialHoles.push(i); if(!silent){ say('点石成金！'+(i+1)+' 号孔变为特殊奖励孔（命中奖励 ×2）'); } return true; }
    if(!silent) say('点石成金失败：'+(i+1)+' 号孔保持普通奖励孔。');
    return false;
  }else{
    if(Math.random()<ALCH_DOWN[lv]){
      state.rewardHoles.push(i); state.rewardHoles.sort((a,b)=>a-b);
      if(!silent) say('点石成金成功：'+(i+1)+' 号孔变成了奖励孔！');
      return true;
    }
    if(!silent) say('点石成金失败：'+(i+1)+' 号孔没有变化。');
    return false;
  }
}
async function useAlchemy(){
  const lv=state.actSkills.alchemy;
  if(state.busy){ return; }
  if(state.phase!=='aim'){ toast('要在「确认」之后、发射之前使用','bad'); return; }
  if(lv<1){ toast('尚未学习点石成金','bad'); return; }
  if(state.alchemyUsed){ toast('本回合已经用过了','bad'); return; }
  if(state.target===null){ toast('先点一个孔作为目标','bad'); return; }
  const i=state.target;
  if(state.specialHoles.indexOf(i)>=0){ toast('该孔已经是特殊奖励孔','bad'); return; }
  const wasReward=state.rewardHoles.indexOf(i)>=0;
  const okk=applyAlchemy(i,lv,false);
  state.alchemyUsed=true; state.stats.alchemy++;
  state.busy=true; renderHUD();
  await alchemyFx(i,okk,wasReward?'special':'reward');
  state.busy=false;
  const kind=wasReward?'特殊奖励孔':'奖励孔';
  pushLog('buff','点石成金 Lv'+lv+' → '+(i+1)+' 号孔：'+(okk?('变成'+kind):'改造失败'),'🪄');
  toast(okk?('成功：'+(i+1)+' 号孔变成'+kind):('失败：'+(i+1)+' 号孔没有变化'), okk?'good':'bad');
  renderHoles(); renderCenter(); renderHUD(); refreshPanel(); save();
}
async function fire(){
  if(state.phase!=='aim'||state.busy) return;
  if(state.target===null){ toast('请先点选一个孔作为目标','bad'); return; }
  const target=state.target, landed=pickLanding(target);
  const isWin=state.rewardHoles.indexOf(landed)>=0;
  const isSpecial=state.specialHoles.indexOf(landed)>=0;
  state.phase='firing';
  renderHUD(); setHint('发射中…'); SFX.drop();
  await launchSequence(landed);
  if(state.fast) await wait(60);
  const st=state.stats;
  st.rounds++; profile.life.rounds++;
  let gain=0, extra=0;
  const el=holeEls[landed];
  el.classList.add('landed',isWin?'ok':'no');
  setTimeout(()=>el.classList.remove('landed','ok','no'),720);

  if(isWin){
    const mult=isSpecial?2:1;
    const base=state.rewardValue*state.roundBet*mult;
    extra=state.pity.wxtd; gain=base+extra;
    state.marbles+=gain;
    gotMarbles(gain);
    st.wins++; st.marblesOut+=gain; st.streak++;
    st.bestStreak=Math.max(st.bestStreak,st.streak);
    st.bestWin=Math.max(st.bestWin,gain); st.bestMult=Math.max(st.bestMult,state.roundBet);
    if(isSpecial) st.specialHits++;
    st.missStreak=0;
    profile.life.wins++; profile.life.bestStreak=Math.max(profile.life.bestStreak,st.streak);
    profile.life.bestWin=Math.max(profile.life.bestWin,gain);
    const profit=gain-state.roundBet, pos=holeCenter(landed);
    floatText('+'+gain+' 弹珠',pos,isSpecial?'#ff5168':'#3ddc97');
    if(extra>0) setTimeout(()=>floatText('卧薪尝胆 +'+extra,{x:pos.x,y:pos.y-34},'#ffc79a'),250);
    (gain>=state.roundBet*8?SFX.big:SFX.win)();
    pushLog('win','命中 '+(landed+1)+' 号'+(isSpecial?'（特殊 ×2）':'')+' · '+state.rewardValue+'×'+state.roundBet+(isSpecial?'×2':'')+
      (extra?' +卧薪 '+extra:'')+' · 净 '+((profit>=0?'+':'')+profit),'+'+gain);
    const consumed=[];
    if(state.pity.hit){consumed.push('命中加成');state.pity.hit=false;}
    if(state.pity.luck){consumed.push('广撒网');state.pity.luck=false;}
    if(state.pity.fortune){consumed.push('聚宝盆');state.pity.fortune=false;}
    if(state.pity.wxtd>0){consumed.push('卧薪尝胆×'+state.pity.wxtd);state.pity.wxtd=0;}
    state.pity.counter=0;
    if(consumed.length) pushLog('buff','激励 BUFF 已消耗：'+consumed.join('、'),'—');
    say('中奖！落在 '+(landed+1)+' 号'+(isSpecial?'特殊':'')+'奖励孔，获得 '+gain+' 颗（净 '+((profit>=0?'+':'')+profit)+'）。');
    setHint('🎉 命中 <b>'+(landed+1)+'</b> 号'+(isSpecial?'<span style="color:var(--red)">特殊</span>':'')+'奖励孔：'+
      state.rewardValue+' × '+state.roundBet+(isSpecial?' × 2':'')+(extra?' + 卧薪 '+extra:'')+' = <b>'+gain+'</b> 颗');
  }else{
    st.missStreak++; profile.life.misses++;
    floatText('未命中 -'+state.roundBet,holeCenter(landed),'#ff5168');
    SFX.miss();
    pushLog('lose','落入 '+(landed+1)+' 号孔（非奖励孔） · 未命中','-'+state.roundBet);
    state.pity.counter++;
    if(state.pity.counter>=state.pity.threshold){
      state.pity.counter=0;
      const card=grantPityBuff();
      showBuffCards([card]);
      state.pity.threshold=randInt(CFG.pityMin,CFG.pityMax);
    }
    setHint('未命中 · 激励倒计时 <b>'+state.pity.counter+'/'+state.pity.threshold+'</b>');
  }
  for(const k of PROMO_KEYS){ const b=state.promo[k]; if(b&&b.rounds>0){ b.rounds--; if(b.rounds<=0){ b.rounds=0; b.lv=0; } } }
  // 技能加点在下回合生效
  state.actSkills=Object.assign({},profile.skills);
  state.phase='ready'; state.roundBet=0; state.rewardHoles=[]; state.specialHoles=[]; state.rewardValue=0;
  state.target=null; state.preview={holes:[],value:0}; state.alchemyUsed=false;
  pushCurve();
  checkAcv();
  renderHoles(); renderHUD(); refreshPanel(); save();
  if(state.auto) setTimeout(autoStep, state.fast?80:320);
}
function grantPityBuff(){
  const pool=['hit','luck','fortune'].filter(k=>!state.pity[k]);
  if(state.pity.wxtd===0) pool.push('wxtd');
  let got='', card=null;
  if(pool.length===0){
    state.pity.wxtd+=1; got='卧薪尝胆 +1 层（已集齐）';
    card={icon:'🔥',name:'卧薪尝胆',pity:true,effect:'命中后额外 +'+state.pity.wxtd+' 颗',delta:'+1 层',text:got};
  }else{
    const k=pick(pool);
    if(k==='wxtd'){
      const bonus=hasPityBuff()?1:(1+CFG.wxtdBonus);
      state.pity.wxtd+=bonus;
      got='卧薪尝胆 ×'+state.pity.wxtd+(bonus>1?'（独占额外 +'+CFG.wxtdBonus+' 层）':'');
      card={icon:'🔥',name:'卧薪尝胆',pity:true,effect:'命中后额外 +'+state.pity.wxtd+' 颗弹珠',delta:'+'+bonus+' 层',text:got};
    }else{
      state.pity[k]=true;
      const map={hit:{i:'🎯',n:'命中加成',a:'命中 +1'},luck:{i:'🧩',n:'广撒网',a:'幸运 +1'},fortune:{i:'💰',n:'聚宝盆',a:'财运 +1'}};
      const m=map[k]; got=m.n+'（'+m.a+'）';
      card={icon:m.i,name:m.n,pity:true,effect:m.a+' · 命中一次后消失',delta:'+1 点',text:got};
    }
  }
  state.stats.buffsGained++; SFX.buff();
  pushLog('buff','连续 '+state.pity.threshold+' 回合未命中 → 激励 BUFF：'+got,'✨');
  say('连续未命中触发激励 BUFF：'+got+'。');
  return card;
}
function floatText(txt,pos,color){
  const el=document.createElement('div'); el.className='float'; el.textContent=txt; el.style.color=color;
  el.style.left=pos.x+'px'; el.style.top=(pos.y-30)+'px';
