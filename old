function holeCenter(i){
  const r=holeEls[i].getBoundingClientRect(), b=boardEl.getBoundingClientRect();
  return {x:r.left-b.left+r.width/2, y:r.top-b.top+r.height/2};
}
function ballAt(ball,p){ ball.style.transform='translate('+p.x+'px,'+p.y+'px) translate(-50%,-50%)'; }
function moveBall(ball,to,ms,ease){
  const from=ball.__pos||to;
  const kf=[{transform:'translate('+from.x+'px,'+from.y+'px) translate(-50%,-50%)'},
            {transform:'translate('+to.x+'px,'+to.y+'px) translate(-50%,-50%)'}];
  ball.__pos=to;
  return ball.animate(kf,{duration:ms,easing:ease||'ease-in-out',fill:'forwards'}).finished.catch(()=>{});
}
function arcBall(ball,to,ms,peak){
  const from=ball.__pos||to;
  const kf=[];
  for(let i=0;i<=12;i++){
    const t=i/12;
    const x=from.x+(to.x-from.x)*t;
    const y=from.y+(to.y-from.y)*t - Math.sin(Math.PI*t)*peak;
    kf.push({offset:t,transform:'translate('+x+'px,'+y+'px) translate(-50%,-50%)'});
  }
  ball.__pos=to;
  return ball.animate(kf,{duration:ms,easing:'linear',fill:'forwards'}).finished.catch(()=>{});
}
/* 完整体验：确认后调用 */
async function launchSequence(landed){
  const g=geom;
  if(state.fast) return;
  const sp=1/Math.max(0.5,CFG.animSpeed||1);
  const ball=document.createElement('div');
  ball.className='ball'; ball.dataset.skin=profile.equip;
  ballLayer.appendChild(ball);
  const start={x:g.chuteX-g.chuteW/2-30, y:g.trayBottom-14};
  ball.__pos=start; ballAt(ball,start);
  startTrail(ball);
  await wait(120*sp);
  // ① 隔板打开
  $('#gate').classList.add('open'); SFX.gate();
  await wait(260*sp);
  // ② 弹珠流入发射槽
  await moveBall(ball,{x:g.chuteX,y:g.chuteBottom-16},420*sp,'ease-in-out');
  // ③ 隔板关闭
  $('#gate').classList.remove('open');
  await wait(180*sp);
  // ④ 击打装置
  const st=$('#striker'); st.classList.add('push'); SFX.hit();
  await wait(110*sp);
  st.classList.remove('push');
  // ⑤ 沿发射槽一路向上
  await moveBall(ball,{x:g.chuteX,y:g.chuteTop+14},300*sp,'ease-out');
  // ⑥ 被弹到 12 个孔上方，再落到实际命中孔
  const hc=holeCenter(landed);
  await arcBall(ball,{x:hc.x,y:Math.max(24,hc.y-90)},420*sp,90);
  await moveBall(ball,{x:hc.x,y:hc.y},180*sp,'ease-in');
  // ⑦ 最后掉进孔下方斜坡准备区
  await moveBall(ball,{x:hc.x,y:g.trayBottom-12},300*sp,'ease-in');
  stopTrail();
  ball.style.transition='opacity .35s'; ball.style.opacity='0';
  setTimeout(()=>ball.remove(),420);
}

