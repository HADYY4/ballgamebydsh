<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>弹珠机 PRO · 幸运打珠</title>
<style>
/* ============ 主题变量（默认：深夜霓虹） ============ */
:root{
  --bg1:#1c2444; --bg2:#0b0e18; --bg3:#05060a;
  --panel:#12151f; --panel2:#181d2b; --panel3:#1e2434; --line:#2a3145;
  --text:#e9edf9; --dim:#8d97b1; --dim2:#616b85;
  --gold:#ffcf5c; --gold2:#ff9d2e; --red:#ff5168; --green:#3ddc97; --blue:#5aa8ff; --purple:#a97bff;
  --radius:16px; --radius-sm:10px; --gap:14px; --side:424px;
  --font:"Segoe UI","Microsoft YaHei",system-ui,-apple-system,"PingFang SC",sans-serif;
  --board-bg:radial-gradient(760px 420px at 50% 6%, rgba(90,168,255,.10), transparent 70%),linear-gradient(180deg,#0c1020,#080a12 70%);
  --card-inset:inset 0 1px 0 rgba(255,255,255,.03);
  --input-bg:#0e1220; --soft:#0e1220;
}
body[data-theme="daylight"]{
  --bg1:#ffffff; --bg2:#eef2f8; --bg3:#dfe6f0;
  --panel:#ffffff; --panel2:#f5f8fc; --panel3:#eaeff7; --line:#ccd6e4;
  --text:#16202f; --dim:#5a6a80; --dim2:#8494a8;
  --gold:#c8860d; --gold2:#e0a12a; --red:#d63a52; --green:#1a9c68; --blue:#2f74d0; --purple:#7b52c8;
  --radius:14px; --radius-sm:10px; --side:430px;
  --board-bg:radial-gradient(760px 420px at 50% 6%, rgba(47,116,208,.10), transparent 70%),linear-gradient(180deg,#f7fafd,#e8eef7 70%);
  --card-inset:inset 0 1px 0 rgba(255,255,255,.9);
  --input-bg:#ffffff; --soft:#f2f6fc;
}
body[data-theme="arcade"]{
  --bg1:#04140c; --bg2:#020a06; --bg3:#000000;
  --panel:#04140d; --panel2:#061b11; --panel3:#08281a; --line:#12603c;
  --text:#8dffc4; --dim:#46b07f; --dim2:#2c7a56;
  --gold:#f5ff6b; --gold2:#c8e02a; --red:#ff6b6b; --green:#3dff9e; --blue:#5ce1ff; --purple:#c48bff;
  --radius:2px; --radius-sm:2px; --gap:9px; --side:404px;
  --font:"Consolas","Courier New",monospace;
  --board-bg:repeating-linear-gradient(0deg,rgba(0,255,140,.05) 0 1px,transparent 1px 3px),linear-gradient(180deg,#03150d,#000 70%);
  --card-inset:none; --input-bg:#03130c; --soft:#04180f;
}
body[data-theme="sakura"]{
  --bg1:#ffe9f1; --bg2:#fff6f9; --bg3:#f7dbe6;
  --panel:#fffdfe; --panel2:#fff4f8; --panel3:#ffe9f1; --line:#f3c9d9;
  --text:#4a2b3a; --dim:#9a6a80; --dim2:#c08fa4;
  --gold:#e07a9c; --gold2:#f0a0bb; --red:#e04f74; --green:#3aa87a; --blue:#6f8fe0; --purple:#a97bff;
  --radius:24px; --radius-sm:16px; --gap:16px; --side:438px;
  --board-bg:radial-gradient(700px 400px at 50% 8%, rgba(224,122,156,.16), transparent 70%),linear-gradient(180deg,#fff6f9,#ffe6ef 70%);
  --card-inset:inset 0 1px 0 rgba(255,255,255,.9); --input-bg:#ffffff; --soft:#fff2f7;
}
body[data-theme="vegas"]{
  --bg1:#3a0d10; --bg2:#150406; --bg3:#080000;
  --panel:#1a0709; --panel2:#250a0d; --panel3:#330f13; --line:#5e1f24;
  --text:#ffe9c9; --dim:#c99a72; --dim2:#8e6547;
  --gold:#ffd35c; --gold2:#ffa41f; --red:#ff3b46; --green:#4be09a; --blue:#66b3ff; --purple:#c98bff;
  --radius:8px; --radius-sm:6px; --gap:12px; --side:428px;
  --board-bg:radial-gradient(700px 400px at 50% 8%, rgba(255,164,31,.14), transparent 70%),linear-gradient(180deg,#1c0508,#0a0000 70%);
  --card-inset:inset 0 1px 0 rgba(255,215,120,.10); --input-bg:#170406; --soft:#1d0608;
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;color:var(--text);font-family:var(--font);
  background:radial-gradient(1200px 720px at 50% -12%, var(--bg1) 0%, var(--bg2) 55%, var(--bg3) 100%);
  overflow:hidden;transition:background .35s;
}
button{font-family:inherit}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:var(--line);border-radius:9px}
::-webkit-scrollbar-track{background:transparent}

.app{display:grid;grid-template-columns:minmax(0,1fr) var(--side);gap:var(--gap);height:100vh;padding:var(--gap)}
.col{display:flex;flex-direction:column;gap:var(--gap);min-height:0}
.card{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);
  border-radius:var(--radius);box-shadow:0 12px 34px rgba(0,0,0,.35), var(--card-inset)}
body[data-theme="arcade"] .card{box-shadow:none}
body[data-theme="vegas"] .card{border-color:#7a2a1c}

/* ---------- 顶栏 ---------- */
.hud{display:flex;align-items:center;gap:9px;padding:10px 12px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:9px;padding-right:12px;border-right:1px solid var(--line);margin-right:2px}
.brand .logo{width:34px;height:34px;border-radius:var(--radius-sm);display:grid;place-items:center;font-size:19px;
  background:linear-gradient(160deg,var(--panel3),var(--panel));border:1px solid var(--line)}
.brand .t{font-weight:800;letter-spacing:.5px;font-size:15px}
.brand .s{font-size:11px;color:var(--dim2);letter-spacing:2px}
.stat{display:flex;align-items:center;gap:8px;padding:6px 11px;border-radius:var(--radius-sm);
  background:var(--panel3);border:1px solid var(--line);min-width:74px}
.stat .k{font-size:11px;color:var(--dim2)}
.stat .v{font-size:18px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1.15}
.stat.gold .v{color:var(--gold)} .stat.blue .v{color:var(--blue)} .stat.green .v{color:var(--green)}
.stat.red .v{color:var(--red)} .stat.purple .v{color:var(--purple)}
.spacer{flex:1}
.pill{font-size:11px;padding:4px 9px;border-radius:999px;border:1px solid var(--line);background:var(--soft);color:var(--dim);white-space:nowrap}

/* ---------- 机器 ---------- */
.machine{position:relative;flex:1;min-height:380px;display:flex;flex-direction:column;overflow:hidden}
.marquee{display:flex;align-items:center;gap:10px;padding:7px 14px;font-size:12.5px;color:var(--gold);
  background:linear-gradient(90deg,var(--panel3),var(--soft));border-bottom:1px solid var(--line);white-space:nowrap;overflow:hidden}
.marquee .dot{width:7px;height:7px;border-radius:50%;background:var(--gold);box-shadow:0 0 10px var(--gold);animation:blink 1.1s infinite}
@keyframes blink{50%{opacity:.25}}
.marquee .scroll{flex:1;overflow:hidden;text-overflow:ellipsis}
.buffbar{display:flex;gap:6px;flex-wrap:wrap;padding:7px 12px;border-bottom:1px solid var(--line);background:var(--soft);min-height:34px;align-items:center}
.buffbar .none{font-size:11.5px;color:var(--dim2)}
.buff{font-size:11.5px;padding:3px 9px;border-radius:999px;border:1px solid var(--line);background:var(--panel);white-space:nowrap;font-variant-numeric:tabular-nums}
.buff.pity{border-color:#b8860b;color:var(--gold)}
.buff.wxtd{border-color:var(--red);color:var(--red)}
.buff.hit{border-color:var(--blue);color:var(--blue)}
.buff.luck{border-color:var(--green);color:var(--green)}
.buff.fortune{border-color:var(--purple);color:var(--purple)}
.buff.promo{border-color:var(--line);color:var(--dim)}

.board{position:relative;flex:1;min-height:340px;overflow:hidden;background:var(--board-bg)}
.board::after{content:"";position:absolute;inset:0;pointer-events:none;z-index:2}
body[data-theme="arcade"] .board::after{background:repeating-linear-gradient(0deg,rgba(0,0,0,.35) 0 1px,transparent 1px 3px)}
.pegs{position:absolute;inset:0;opacity:.45;
  background-image:radial-gradient(circle, var(--dim2) 1.3px, transparent 1.6px);
  background-size:34px 30px;background-position:17px 12px;
  mask-image:linear-gradient(180deg,rgba(0,0,0,.85),rgba(0,0,0,.25) 78%,transparent);
  -webkit-mask-image:linear-gradient(180deg,rgba(0,0,0,.85),rgba(0,0,0,.25) 78%,transparent)}

/* 机构：斜坡准备区 / 发射槽 / 隔板 / 击打装置 / 孔间隔柱 */
.tray{position:absolute;left:0;right:0;border-top:2px solid var(--line);
  background:linear-gradient(180deg,rgba(120,140,180,.10),rgba(20,24,36,.5));
  border-bottom-left-radius:8px;border-bottom-right-radius:8px;pointer-events:none;z-index:1}
.tray::before{content:"";position:absolute;left:0;right:0;top:-1px;height:14px;
  background:linear-gradient(180deg,rgba(160,180,220,.18),transparent)}
.chute{position:absolute;border:1px solid var(--line);border-radius:6px;pointer-events:none;z-index:2;
  background:linear-gradient(90deg,rgba(255,255,255,.05),rgba(0,0,0,.28),rgba(255,255,255,.05));
  box-shadow:inset 0 0 12px rgba(0,0,0,.5)}
.chute::before{content:"";position:absolute;left:50%;top:0;bottom:0;width:1px;background:repeating-linear-gradient(180deg,var(--line) 0 6px,transparent 6px 12px);opacity:.6}
.gate{position:absolute;z-index:3;pointer-events:none;background:linear-gradient(180deg,var(--gold),var(--gold2));
  border-radius:2px;transform-origin:left center;transition:transform .28s ease}
.gate.open{transform:rotate(-72deg)}
.striker{position:absolute;z-index:4;pointer-events:none;border-radius:3px;
  background:linear-gradient(180deg,#8f9ab8,#3b445e);
  border:1px solid var(--line);transition:transform .12s ease}
.striker.push{transform:translateY(-16px)}
.divider{position:absolute;width:5px;z-index:1;pointer-events:none;border-radius:3px;
  background:linear-gradient(180deg,rgba(190,210,255,.30),rgba(190,210,255,.06));
  box-shadow:inset 0 0 4px rgba(255,255,255,.35);transform:translateX(-50%)}

/* 中间奖励面板 */
.center-panel{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);
  width:min(340px,62%);padding:13px 18px 11px;border-radius:var(--radius);text-align:center;
  background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);
  box-shadow:0 18px 46px rgba(0,0,0,.45);z-index:3}
.center-panel.rolling{border-color:var(--gold2);box-shadow:0 0 34px rgba(255,170,40,.22)}
.center-panel.locked{border-color:var(--gold);box-shadow:0 0 40px rgba(255,190,60,.3)}
.cp-label{font-size:11.5px;color:var(--dim2);letter-spacing:3px}
.cp-value{font-size:44px;font-weight:900;line-height:1.05;font-variant-numeric:tabular-nums;color:var(--gold)}
body[data-theme="arcade"] .cp-value{text-shadow:0 0 14px var(--gold)}
.cp-value.rolling{opacity:.85}
.cp-value small{font-size:17px;font-weight:800;color:var(--dim)}
.cp-sub{font-size:12px;color:var(--dim);margin-top:2px;font-variant-numeric:tabular-nums}
.cp-sub b{color:var(--gold)}
.cp-calc{font-size:12px;color:var(--dim);margin-top:6px;padding-top:6px;border-top:1px dashed var(--line);font-variant-numeric:tabular-nums}
.cp-calc b{color:var(--green)}

.hole{position:absolute;width:54px;height:54px;margin:0;transform:translate(-50%,-50%);
  border-radius:50%;display:grid;place-items:center;background:var(--panel3);
  border:2px solid var(--line);cursor:not-allowed;transition:transform .16s, box-shadow .2s, border-color .2s;color:var(--dim);z-index:3}
body[data-theme="arcade"] .hole{border-radius:3px}
body[data-theme="vegas"] .hole{border-radius:50%;border-color:#7a2a1c}
.hole .no{font-size:14px;font-weight:800;font-variant-numeric:tabular-nums;opacity:.75}
.hole .tag{position:absolute;top:-11px;left:50%;transform:translateX(-50%);font-size:10.5px;font-weight:800;
  padding:2px 7px;border-radius:999px;white-space:nowrap;background:var(--soft);border:1px solid var(--line);color:var(--dim2);opacity:0;transition:.2s}
.hole.reward{border-color:var(--gold);cursor:pointer;color:var(--gold);
  background:radial-gradient(circle at 36% 28%, rgba(255,200,90,.22), var(--panel3) 74%);
  box-shadow:0 0 18px rgba(255,170,40,.35), inset 0 0 16px rgba(255,170,40,.18)}
.hole.reward .no{opacity:1}
.hole.reward .tag{opacity:1;color:#1a1206;background:linear-gradient(180deg,var(--gold),var(--gold2));border-color:var(--gold2)}
.hole.reward:hover{transform:translate(-50%,-50%) scale(1.1)}
.hole.special{border-color:var(--red)!important;color:#ffd9dd!important;
  background:radial-gradient(circle at 36% 28%, rgba(255,60,80,.38), var(--panel3) 76%)!important;
  box-shadow:0 0 24px rgba(255,60,80,.75), inset 0 0 18px rgba(255,60,80,.35)!important;animation:sp 1.1s ease-in-out infinite}
.hole.special .tag{background:linear-gradient(180deg,#ff8a94,var(--red))!important;border-color:var(--red)!important;color:#fff!important}
@keyframes sp{50%{box-shadow:0 0 34px rgba(255,60,80,.95), inset 0 0 22px rgba(255,60,80,.5)}}
.hole.flash{border-color:var(--gold2)}
.hole.target{border-color:#fff;box-shadow:0 0 0 4px rgba(255,207,92,.20), 0 0 30px rgba(255,190,60,.6);transform:translate(-50%,-50%) scale(1.12)}
.hole.target::after{content:"";position:absolute;inset:-13px;border-radius:50%;border:2px dashed var(--gold);animation:spin 5s linear infinite}
body[data-theme="arcade"] .hole.target::after{border-radius:4px}
.hole.neighbor{box-shadow:0 0 0 3px rgba(90,168,255,.18), 0 0 20px rgba(90,168,255,.35)}
.hole.landed{animation:landed .7s ease-out}
.hole.landed.ok{border-color:var(--green);box-shadow:0 0 0 5px rgba(61,220,151,.22),0 0 40px rgba(61,220,151,.65)}
.hole.landed.no{border-color:var(--red);box-shadow:0 0 0 5px rgba(255,81,104,.18),0 0 34px rgba(255,81,104,.5)}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes landed{0%{transform:translate(-50%,-50%) scale(1.35)}100%{transform:translate(-50%,-50%) scale(1)}}

.ball{position:absolute;left:0;top:0;width:16px;height:16px;border-radius:50%;
  background:radial-gradient(circle at 34% 30%, #ffffff, #cfe0ff 40%, #7d93c4 100%);
  box-shadow:0 0 14px rgba(180,210,255,.85), 0 2px 6px rgba(0,0,0,.6);will-change:transform;z-index:6}
.ball[data-skin="yuanbao"]{background:radial-gradient(circle at 34% 30%,#fff6d0,#ffcf5c 42%,#b8860b 100%);box-shadow:0 0 16px rgba(255,200,80,.95)}
.ball[data-skin="clover"]{background:radial-gradient(circle at 34% 30%,#e8fff2,#4be09a 42%,#127a4d 100%);box-shadow:0 0 16px rgba(75,224,154,.95)}
.ball[data-skin="target"]{background:radial-gradient(circle at 50% 50%,#fff 0 22%,#ff5168 23% 46%,#fff 47% 62%,#ff5168 63% 100%);box-shadow:0 0 16px rgba(255,81,104,.95)}
.ball[data-skin="normal"]{background:radial-gradient(circle at 34% 30%, #ffffff, #cfe0ff 40%, #7d93c4 100%)}
.float{position:absolute;font-weight:900;font-size:22px;pointer-events:none;z-index:8;
  text-shadow:0 2px 14px rgba(0,0,0,.85);animation:floatUp 1.3s ease-out forwards;white-space:nowrap}
@keyframes floatUp{0%{opacity:0;transform:translate(-50%,0) scale(.7)}18%{opacity:1;transform:translate(-50%,-14px) scale(1.12)}100%{opacity:0;transform:translate(-50%,-64px) scale(1)}}

.hint{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);font-size:12.5px;color:var(--dim);
  background:color-mix(in srgb,var(--panel) 88%,transparent);border:1px solid var(--line);padding:6px 14px;border-radius:999px;
  white-space:nowrap;z-index:5;max-width:96%;overflow:hidden;text-overflow:ellipsis}
.hint b{color:var(--gold)}
.roundbar{position:absolute;left:14px;top:12px;display:flex;gap:8px;flex-wrap:wrap;z-index:5;max-width:calc(100% - 28px)}
.chip{font-size:11.5px;padding:5px 10px;border-radius:var(--radius-sm);background:color-mix(in srgb,var(--panel) 88%,transparent);border:1px solid var(--line);color:var(--dim)}
.chip b{color:var(--text)}
.chip.hot{border-color:var(--gold2);color:var(--gold)}
.chip.spec{border-color:var(--red);color:var(--red)}

/* ---------- 操作区 ---------- */
.controls{padding:11px 12px;display:flex;flex-direction:column;gap:9px;border-top:1px solid var(--line);background:var(--soft)}
.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.label{font-size:12px;color:var(--dim2);min-width:56px}
.btn{padding:9px 15px;border-radius:var(--radius-sm);border:1px solid var(--line);background:var(--panel3);color:var(--text);font-weight:800;font-size:13.5px;cursor:pointer;transition:.15s}
.btn:hover:not(:disabled){border-color:var(--gold2);transform:translateY(-1px)}
.btn:disabled{opacity:.3;cursor:not-allowed;transform:none}
.btn.primary{background:linear-gradient(180deg,var(--gold),var(--gold2));color:#171106;border-color:var(--gold2)}
.btn.primary.pulse{animation:btnPulse 1.25s ease-in-out infinite}
.btn.green{background:linear-gradient(180deg,#5be3a8,#25a86f);color:#04170f;border-color:#1c6b47}
.btn.green.pulse{animation:btnPulse 1.25s ease-in-out infinite}
.btn.magic{background:linear-gradient(180deg,#ff9aa6,#d81f36);color:#fff;border-color:#8b1220}
.btn.magic.pulse{animation:btnPulse 1.25s ease-in-out infinite}
.btn.ghost{background:var(--soft)}
.btn.danger{border-color:var(--red);color:var(--red);background:var(--soft)}
.btn.danger.pulse{animation:btnPulse 1.25s ease-in-out infinite}
.btn.sm{padding:6px 11px;font-size:12.5px;border-radius:var(--radius-sm);font-weight:700}
@keyframes btnPulse{50%{box-shadow:0 8px 30px rgba(255,150,30,.6)}}
.toggle{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--dim);cursor:pointer;user-select:none;padding:6px 10px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--soft)}
.toggle input{accent-color:var(--gold);margin:0}
.toggle.on{color:var(--text);border-color:var(--gold2)}
input[type=number]{width:72px;padding:8px 9px;border-radius:var(--radius-sm);background:var(--input-bg);border:1px solid var(--line);color:var(--text);font-family:inherit;font-size:13.5px;font-weight:700}

/* ---------- 侧栏 ---------- */
.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;padding:8px}
.tab{padding:8px 4px;text-align:center;font-size:12px;font-weight:800;border-radius:var(--radius-sm);cursor:pointer;color:var(--dim);border:1px solid transparent}
.tab.sel{background:var(--panel3);color:var(--gold);border-color:var(--line)}
.panelbody{flex:1;overflow-y:auto;padding:0 12px 12px;min-height:0}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.kpi{background:var(--panel3);border:1px solid var(--line);border-radius:var(--radius-sm);padding:9px 11px}
.kpi .k{font-size:11px;color:var(--dim2);margin-bottom:3px}
.kpi .v{font-size:17px;font-weight:800;font-variant-numeric:tabular-nums}
.kpi .v.g{color:var(--green)} .kpi .v.r{color:var(--red)} .kpi .v.a{color:var(--gold)} .kpi .v.b{color:var(--blue)} .kpi .v.p{color:var(--purple)}
h4{margin:14px 0 8px;font-size:12px;color:var(--dim2);letter-spacing:1px;font-weight:700;border-bottom:1px solid var(--line);padding-bottom:6px}
.chart{width:100%;height:96px;display:block;border-radius:var(--radius-sm);background:var(--soft);border:1px solid var(--line)}
.log{display:flex;flex-direction:column;gap:5px;font-size:12px}
.logrow{display:flex;gap:8px;align-items:center;padding:6px 9px;border-radius:var(--radius-sm);background:var(--soft);border:1px solid var(--line)}
.logrow .n{color:var(--dim2);font-variant-numeric:tabular-nums;min-width:26px;font-size:11px}
.logrow.win{border-color:var(--green)}
.logrow.lose{opacity:.75}
.logrow.buy{border-color:var(--gold2)}
.logrow.buff{border-color:var(--purple)}
.logrow.acv{border-color:var(--gold)} .logrow.acv .amt{color:var(--gold)}
.logrow.draw{border-color:var(--blue)} .logrow.draw .amt{color:var(--blue)}
.logrow .txt{flex:1}
.logrow .amt{font-weight:800;font-variant-numeric:tabular-nums}
.logrow.win .amt{color:var(--green)} .logrow.lose .amt{color:var(--dim2)}
.logrow.buy .amt{color:var(--gold)} .logrow.buff .amt{color:var(--purple)}
.setrow{display:flex;flex-direction:column;gap:6px;padding:9px 0;border-bottom:1px dashed var(--line)}
.setrow .top{display:flex;justify-content:space-between;align-items:center;font-size:12.5px}
.setrow .top .k{color:var(--dim)} .setrow .top .v{font-weight:800;color:var(--gold);font-variant-numeric:tabular-nums}
input[type=range]{width:100%;accent-color:var(--gold);height:18px}
.help{font-size:12.2px;line-height:1.75;color:var(--dim)}
.help b{color:var(--text)}
.help .li{display:flex;gap:8px;margin-bottom:7px}
.help .li i{font-style:normal;flex:0 0 20px;height:20px;border-radius:6px;display:grid;place-items:center;font-size:11px;background:var(--panel3);border:1px solid var(--line);color:var(--gold);font-weight:800}
table.wt{width:100%;border-collapse:collapse;font-size:10.5px;font-variant-numeric:tabular-nums}
table.wt th,table.wt td{border:1px solid var(--line);padding:1px 2px;text-align:center;color:var(--dim)}
table.wt th{color:var(--dim2);background:var(--panel3)}
table.wt tr.now td{background:rgba(255,207,92,.16);color:var(--gold);font-weight:800}

/* 技能 */
.skill{display:flex;gap:10px;align-items:center;padding:10px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel3);margin-bottom:8px}
.skill .ico{width:38px;height:38px;border-radius:var(--radius-sm);display:grid;place-items:center;font-size:20px;background:var(--soft);border:1px solid var(--line)}
.skill .info{flex:1;min-width:0}
.skill .nm{font-size:13px;font-weight:800;display:flex;align-items:center;gap:6px}
.skill .ds{font-size:11.5px;color:var(--dim);margin-top:2px;line-height:1.5}
.pips{display:flex;gap:3px;margin-top:4px}
.pip{width:16px;height:6px;border-radius:3px;background:var(--line)}
.pip.on{background:linear-gradient(90deg,var(--gold),var(--gold2))}
.pending{font-size:10.5px;color:var(--gold2);border:1px solid var(--gold2);border-radius:999px;padding:1px 6px}

/* 成就 */
.acv{position:relative;border-radius:var(--radius-sm);padding:2px;background:var(--line);transition:transform .15s}
.acv:hover{transform:translateY(-2px)}
.acv .in{background:var(--panel3);border-radius:calc(var(--radius-sm) - 2px);padding:7px;height:100%;display:flex;flex-direction:column;gap:4px}
.acv .ttl{font-size:11.5px;font-weight:800;display:flex;gap:4px;align-items:center;line-height:1.25}
.acv .ic{font-size:14px}
.acv .st{font-size:10.5px;color:var(--dim2)}
.acv.locked{opacity:.55}
.acv.locked .in{background:var(--soft)}
.acv.ready{animation:acvPulse 1.4s ease-in-out infinite}
@keyframes acvPulse{50%{filter:brightness(1.25)}}
.acv.r-bronze{background:linear-gradient(135deg,#8a5a2b,#d99a5b)}
.acv.r-silver{background:linear-gradient(135deg,#8f98a8,#e6eefc)}
.acv.r-gold{background:linear-gradient(90deg,#8a5c10,#ffe89a,#8a5c10,#ffd873);background-size:300% 100%;animation:flow 3s linear infinite}
.acv.r-red{background:linear-gradient(90deg,#8b1220,#ffd9dd,#8b1220,#ff8a94);background-size:300% 100%;animation:flow 2.4s linear infinite}
.acv.r-orange{background:linear-gradient(90deg,#8b3a00,#ffd0a0,#8b3a00,#ff9d2e);background-size:300% 100%;animation:flow 2.4s linear infinite}
.acv.r-rainbow{background:linear-gradient(90deg,#ff5168,#ffcf5c,#3ddc97,#5aa8ff,#a97bff,#ff5168);background-size:300% 100%;animation:flow 2s linear infinite}
.acv.r-purple{background:linear-gradient(135deg,#5b3aa8,#d8c4ff,#a97bff);box-shadow:0 0 14px rgba(169,123,255,.5)}
@keyframes flow{to{background-position:300% 0}}
.acv .claim{margin-top:auto;font-size:11px;padding:4px 0;border-radius:6px;border:1px solid var(--gold2);background:linear-gradient(180deg,var(--gold),var(--gold2));color:#171106;font-weight:800;cursor:pointer}
.acv .done{font-size:10.5px;color:var(--dim2);margin-top:auto}
#acvTip{position:fixed;z-index:200;max-width:250px;padding:9px 11px;border-radius:10px;border:1px solid var(--line);
  background:var(--panel);box-shadow:0 16px 40px rgba(0,0,0,.5);font-size:11.5px;line-height:1.6;color:var(--dim);display:none}
#acvTip b{color:var(--text);display:block;margin-bottom:3px;font-size:12.5px}

/* 皮肤 & 抽奖 */
.skin{display:flex;gap:10px;align-items:center;padding:9px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel3);margin-bottom:8px}
.skin.on{border-color:var(--gold);box-shadow:0 0 14px rgba(255,190,60,.25)}
.skin .ballprev{width:34px;height:34px;border-radius:50%}
.skin .info{flex:1}
.skin .nm{font-size:13px;font-weight:800}
.skin .ds{font-size:11.5px;color:var(--dim);margin-top:2px}
.wheelbox{position:relative;width:250px;height:250px;margin:6px auto 4px}
#wheel{width:250px;height:250px;display:block}
.pointer{position:absolute;left:50%;top:-6px;transform:translateX(-50%);width:0;height:0;
  border-left:11px solid transparent;border-right:11px solid transparent;border-top:20px solid var(--gold);filter:drop-shadow(0 2px 6px rgba(0,0,0,.6));z-index:3}
/* 弹珠尾迹 */
.trail{position:absolute;left:0;top:0;width:13px;height:13px;border-radius:50%;pointer-events:none;z-index:5;
  background:radial-gradient(circle,rgba(215,235,255,.95),rgba(120,170,255,0) 70%)}
.trail[data-skin="yuanbao"]{background:radial-gradient(circle,rgba(255,235,160,.95),rgba(255,170,40,0) 70%)}
.trail[data-skin="clover"]{background:radial-gradient(circle,rgba(180,255,215,.95),rgba(60,220,150,0) 70%)}
.trail[data-skin="target"]{background:radial-gradient(circle,rgba(255,190,200,.95),rgba(255,70,100,0) 70%)}
/* 点石成金光效 */
.spark{position:absolute;width:9px;height:9px;border-radius:50%;pointer-events:none;z-index:7;
  background:radial-gradient(circle,#fff,var(--gold) 45%,rgba(255,150,30,0));box-shadow:0 0 12px var(--gold2)}
.alch-ring{position:absolute;border-radius:50%;border:2px solid var(--gold);pointer-events:none;z-index:7}
.alch-ring.spec{border-color:var(--red);box-shadow:0 0 24px var(--red),inset 0 0 18px var(--red)}
.alch-text{position:absolute;z-index:8;font-weight:900;font-size:15px;pointer-events:none;
  text-shadow:0 2px 12px #000;animation:floatUp 1.5s ease-out forwards;white-space:nowrap}
/* BUFF 获得卡片 */
.buffcards{position:fixed;left:50%;top:18%;transform:translateX(-50%);z-index:150;display:flex;flex-direction:column;
  gap:12px;align-items:center;pointer-events:none;max-width:92vw}
.buffrow{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.buffcard{width:136px;padding:12px 10px;border-radius:14px;text-align:center;
  background:linear-gradient(180deg,var(--panel3),var(--panel));border:2px solid var(--gold);
  box-shadow:0 18px 44px rgba(0,0,0,.55);animation:cardIn .36s cubic-bezier(.2,1.4,.4,1) both}
.buffcard.pity{border-color:var(--purple)}
.buffcard .ic{font-size:30px;line-height:1.1}
.buffcard .nm{font-size:14px;font-weight:900;margin-top:4px}
.buffcard .ef{font-size:11.5px;color:var(--dim);margin-top:3px;line-height:1.45}
.buffcard .dl{font-size:14.5px;font-weight:900;color:var(--gold);margin-top:6px}
.buffcard.pity .dl{color:var(--purple)}
@keyframes cardIn{from{opacity:0;transform:translateY(-20px) scale(.78)}to{opacity:1;transform:none}}
/* 成就详情条（固定在面板底部，避免和领取按钮重叠） */
.acvinfo{position:sticky;bottom:-1px;margin-top:10px;padding:10px 12px;border-radius:var(--radius-sm);
  border:1px solid var(--line);background:linear-gradient(180deg,var(--panel3),var(--panel));
  box-shadow:0 -8px 24px rgba(0,0,0,.35);font-size:12px;line-height:1.7;color:var(--dim);z-index:6}
.acvinfo b{color:var(--text)}
.acvinfo .rw{color:var(--gold);font-weight:800}
.acvinfo .st{color:var(--gold2)}
.drawlist{display:flex;flex-direction:column;gap:5px;font-size:12px;margin-top:8px}
.drawrow{display:flex;justify-content:space-between;padding:6px 9px;border-radius:var(--radius-sm);background:var(--soft);border:1px solid var(--line)}
.drawrow .a{font-weight:800;color:var(--gold)}
.toastwrap{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);display:flex;flex-direction:column;gap:8px;z-index:99;align-items:center;pointer-events:none}
.toast{padding:10px 18px;border-radius:var(--radius-sm);font-size:13px;font-weight:700;background:linear-gradient(180deg,var(--panel3),var(--panel));border:1px solid var(--line);box-shadow:0 12px 30px rgba(0,0,0,.5);animation:tin .3s ease-out}
.toast.good{border-color:var(--green);color:var(--green)}
.toast.bad{border-color:var(--red);color:var(--red)}
.toast.buff{border-color:var(--purple);color:var(--purple)}
.toast.acv{border-color:var(--gold);color:var(--gold)}
@keyframes tin{from{opacity:0;transform:translateY(12px)}}
@media (max-width:1240px){
  body{overflow:auto}
  .app{grid-template-columns:1fr;height:auto}
  .machine{min-height:520px}
  .col{min-height:auto}
  .panelbody{max-height:none;overflow:visible}
}
</style>
