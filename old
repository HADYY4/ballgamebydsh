function drawWheel(rot){
  const cv=$('#wheel'); if(!cv) return;
  const g=cv.getContext('2d'), R=125, total=LOTTERY.reduce((a,x)=>a+x.w,0);
  g.clearRect(0,0,250,250);
  let ang=-Math.PI/2 + rot*Math.PI/180;
  LOTTERY.forEach(it=>{
    const sweep=it.w/total*Math.PI*2;
    g.beginPath(); g.moveTo(R,R); g.arc(R,R,R-8,ang,ang+sweep); g.closePath();
    g.fillStyle=it.color; g.globalAlpha=.85; g.fill(); g.globalAlpha=1;
    g.strokeStyle='rgba(0,0,0,.35)'; g.lineWidth=1.5; g.stroke();
    g.save(); g.translate(R,R); g.rotate(ang+sweep/2);
    g.fillStyle='rgba(10,12,20,.92)'; g.font='bold 12px sans-serif';
    g.textAlign='right'; g.textBaseline='middle';
    g.fillText(it.label, R-18, 0);
    g.restore();
    ang+=sweep;
  });
  g.beginPath(); g.arc(R,R,16,0,Math.PI*2); g.fillStyle='#0d1018'; g.fill();
  g.strokeStyle='rgba(255,255,255,.25)'; g.stroke();
}
function labelOf(w){
  return w.id==='marbles3' ? '3 个弹珠' : w.id==='coin1' ? '1 个币' : w.id==='none' ? '谢谢惠顾' : SKINS[w.id].name;
}
function spinTo(winner, dur, cb){
  const total=LOTTERY.reduce((a,x)=>a+x.w,0);
  let acc=0, mid=0;
  for(const it of LOTTERY){ const sweep=it.w/total*360; if(it.id===winner.id){ mid=acc+sweep/2; break; } acc+=sweep; }
  const target=360*5+(360-mid);
  const from=wheelRot%360, t0=performance.now();
  drawing=true;
  const step=now=>{
    const t=Math.min(1,(now-t0)/dur), e=1-Math.pow(1-t,3);
    wheelRot=from+target*e; drawWheel(wheelRot);
    if(t<1) requestAnimationFrame(step);
    else{ wheelRot=target%360; drawing=false; cb&&cb(); }
  };
  requestAnimationFrame(step);
}
