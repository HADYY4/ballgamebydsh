  rollTimer=setInterval(()=>{
    if(state.phase!=='betting') return;
    state.preview={holes:pickRewardHoles(drawHoleCount()), value:drawRewardValue()};
    if(!state.fast) SFX.tick();
    renderHoles(); renderCenter();
  }, state.fast?Math.max(50,CFG.rollMs-40):CFG.rollMs);
  renderHoles(); renderCenter();
}
function stopRoll(){ if(rollTimer){ clearInterval(rollTimer); rollTimer=null; } }
