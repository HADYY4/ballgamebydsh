function drawCurve(){
  const c=$('#curve'); if(!c) return;
  const dpr=window.devicePixelRatio||1, w=c.clientWidth||320, h=c.clientHeight||96;
  c.width=w*dpr; c.height=h*dpr;
  const g=c.getContext('2d'); g.scale(dpr,dpr); g.clearRect(0,0,w,h);
  const data=state.curve.length?state.curve:[state.startMarbles,state.marbles];
  const mn=Math.min.apply(null,data), mx=Math.max.apply(null,data), span=Math.max(1,mx-mn);
  const px=i=>8+(w-16)*(data.length<=1?0.5:i/(data.length-1));
  const py=v=>h-10-(h-24)*((v-mn)/span);
  g.strokeStyle='rgba(128,140,170,.25)'; g.lineWidth=1;
  for(let k=0;k<=3;k++){ const y=8+(h-20)*k/3; g.beginPath(); g.moveTo(6,y); g.lineTo(w-6,y); g.stroke(); }
  const grad=g.createLinearGradient(0,0,0,h);
  grad.addColorStop(0,'rgba(255,207,92,.35)'); grad.addColorStop(1,'rgba(255,207,92,0)');
  g.beginPath(); g.moveTo(px(0),h-6); data.forEach((v,i)=>g.lineTo(px(i),py(v))); g.lineTo(px(data.length-1),h-6);
  g.closePath(); g.fillStyle=grad; g.fill();
  g.beginPath(); data.forEach((v,i)=>{ i?g.lineTo(px(i),py(v)):g.moveTo(px(i),py(v)); });
  g.strokeStyle='#ffcf5c'; g.lineWidth=2; g.lineJoin='round'; g.stroke();
  g.beginPath(); g.arc(px(data.length-1),py(data[data.length-1]),3.4,0,Math.PI*2); g.fillStyle='#fff3cf'; g.fill();
  g.fillStyle='#8d97b1'; g.font='10px system-ui'; g.fillText('高 '+mx,8,12); g.fillText('低 '+mn,8,h-3);
}
