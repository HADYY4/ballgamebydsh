function beep(f,d,t,v,dl){ if(!state.sound) return;
  try{ actx=actx||new (window.AudioContext||window.webkitAudioContext)();
    const t0=actx.currentTime+(dl||0), o=actx.createOscillator(), g=actx.createGain();
    o.type=t||'sine'; o.frequency.setValueAtTime(f,t0);
    g.gain.setValueAtTime(0,t0); g.gain.linearRampToValueAtTime(v||0.05,t0+0.012);
    g.gain.exponentialRampToValueAtTime(0.0001,t0+(d||0.12));
    o.connect(g); g.connect(actx.destination); o.start(t0); o.stop(t0+(d||0.12)+0.03);
  }catch(e){} }
