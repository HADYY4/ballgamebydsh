function skinBonus(name){
  const sk=SKINS[profile.equip]; if(!sk||!sk.attr||sk.attr!==name) return 0;
  return Math.min(sk.cap, (profile.skins[profile.equip]||0)*sk.per);
}
function attrParts(name){
  const p={pity:state.pity[name]?1:0, promo:0, acv:(profile.acvAttr[name]||0), skill:(state.actSkills[name]||0), skin:skinBonus(name)};
  for(const k of PROMO_KEYS){ const b=state.promo[k]; if(b&&b.rounds>0&&PROMO_DEF[k].attr===name) p.promo+=PROMO_DEF[k].val; }
  return p;
}
function attr(name){
  const p=attrParts(name), v=p.pity+p.promo+p.acv+p.skill+p.skin;
  return name==='hit' ? Math.max(0,v) : clamp(v,0,ATTR_CAP);   // 命中不设上限
}
function promoActive(k){ const b=state.promo[k]; return !!(b&&b.rounds>0); }
function hasPityBuff(){ return state.pity.hit||state.pity.luck||state.pity.fortune||state.pity.wxtd>0; }
const luckRow=()=>LUCK_TABLE[attr('luck')];
const fortuneRow=()=>FORTUNE_TABLE[attr('fortune')];
const drawHoleCount=()=>weightedIndex(luckRow())+1;
const drawRewardValue=()=>weightedIndex(fortuneRow())+1;
function holeWeights(target){
  const w=new Array(CFG.holeCount).fill(1);
  if(target!==null&&target!==undefined&&target>=0){
    w[target]+=attr('hit');
    if(target>0) w[target-1]+=1;
    if(target<CFG.holeCount-1) w[target+1]+=1;
  }
  return w;
}
function winChance(target){
  const w=holeWeights(target); let tot=0,win=0;
  for(let i=0;i<w.length;i++){ tot+=w[i]; if(state.rewardHoles.indexOf(i)>=0) win+=w[i]; }
  return tot? win/tot : 0;
}
const pickLanding=t=>weightedIndex(holeWeights(t));
function bestTarget(){ let b=null,v=-1; for(let i=0;i<CFG.holeCount;i++){ const x=winChance(i); if(x>v){v=x;b=i;} } return b; }
function pickRewardHoles(k){
  k=clamp(k,1,CFG.holeCount);
  const pool=[]; for(let i=0;i<CFG.holeCount;i++) pool.push(i);
  for(let i=pool.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); const t=pool[i]; pool[i]=pool[j]; pool[j]=t; }
  return pool.slice(0,k).sort((a,b)=>a-b);
}

